{
	"$schema": "https://turborepo.dev/schema.json",
	"ui": "tui",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**"],
			"cache": true
		},
		"dev": {
			"dependsOn": ["^dev"],
			"outputs": ["dist/**"],
			"cache": true
		},
		"lint": {
			"dependsOn": [],
			"cache": true
		},
		"check": {
			"cache": true,
			"dependsOn": ["^dev"]
		},
		"tests": {
			"dependsOn": ["^dev"],
			"cache": true
		},
	}
}
